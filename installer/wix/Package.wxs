<?xml version="1.0" encoding="utf-8"?>
<!--
  Recapybara MSI: per-user (no UAC), unsigned, no custom actions. Built by scripts\build-msi.ps1.

  Frozen layer (D50), never derived from productName; src-tauri/src/lib.rs pins each one in a test:
    - UpgradeCode, so every later build (a rename included) upgrades in place
    - install folder %LOCALAPPDATA%\Programs\com.lawls91.recapybara
    - the Start-menu shortcut's System.AppUserModel.ID com.lawls91.recapybara (the toast AUMID;
      Windows drops toasts whose AUMID matches no shortcut)
    - the HKCU Run value name Recapybara (the app's start-at-logon writes the same name)
  Display layer: $(var.ProductName) only (Apps & features entry, shortcut name).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="$(var.ProductName)" Manufacturer="lawls91" Version="$(var.Version)"
           UpgradeCode="{6D924D52-CF86-41C9-8AD5-364EF36A2E0D}"
           Scope="perUser" Compressed="yes">

    <!-- Schedule afterInstallExecute: the new version installs first; the old one is removed only once that install
         has committed, so a failed install (a corrupt cabinet, 1603 at file copy) never touches the old product, which
         stays installed, registered and uninstallable. Removing the old version inside the new install's transaction
         (afterInstallInitialize) rolled the files back but left the old product only advertised (no ARP entry, an
         uninstall that removed nothing); WiX's default, afterInstallValidate, left no app at all.
         This schedule leans on the component rules, which hold here:
         - Each component's GUID is WiX's auto GUID, made from its key path (the exe's install path, the Run value, the
           shortcut component's registry value), so the same resource keeps the same GUID across versions: the new
           product shares it and the old product's removal leaves it alone ("another client exists").
         - The shortcut's name follows productName, so its key-path value name does too: a rename makes a new shortcut
           component, and the old product's removal deletes the old-name shortcut with its own component.
         - REINSTALLMODE emus (default omus): e replaces a versioned file of an equal version too, so a same-version
           rebuild (a rename, AllowSameVersionUpgrades) still replaces the exe, whose version Tauri stamps; a newer
           version replaces it under either. Not amus: a would also overwrite newer files and modified unversioned
           files; the payload is the one versioned exe, so e is all that is needed.
         AllowSameVersionUpgrades: a same-version rebuild upgrades in place, so one Apps & features entry. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute" />
    <Property Id="REINSTALLMODE" Value="emus" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="LOGONRUN">
      <RegistrySearch Id="LogonRunSearch" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="Recapybara" Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="com.lawls91.recapybara" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="$(var.ProductName)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="LogonRun" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <!-- No Icon= attribute: the shortcut takes its icon from the exe (tauri-build embeds icon.ico), a path
         that survives upgrades; an Icon= path points into the per-ProductCode installer cache, which a
         MajorUpgrade deletes (a lesson learned). -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
      <Shortcut Id="StartLnk" Name="$(var.ProductName)"
                Target="[INSTALLFOLDER]recapybara.exe" WorkingDirectory="INSTALLFOLDER">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="com.lawls91.recapybara" />
      </Shortcut>
      <!-- Named after the shortcut, so a rename changes this component's auto GUID (see MajorUpgrade). -->
      <RegistryValue Root="HKCU" Key="Software\com.lawls91.recapybara" Name="StartMenu $(var.ProductName)"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Start at logon (D31) on from a fresh install, as the app's own toggle writes it; uninstall removes it.
         An upgrade keeps the user's choice: it writes the value only if it was there before (AppSearch runs
         before RemoveExistingProducts, so LOGONRUN sees the pre-upgrade state).
         ponytail: if the user turned logon off, upgraded, then turned it on again in the app, uninstall leaves
         that app-written value behind (pointing at the removed exe). Fix needs a custom action; not worth one. -->
    <Component Id="LogonRun" Directory="INSTALLFOLDER" Guid="*" Condition="NOT WIX_UPGRADE_DETECTED OR LOGONRUN">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="Recapybara" Type="string"
                     Value="&quot;[INSTALLFOLDER]recapybara.exe&quot; --autostart" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
